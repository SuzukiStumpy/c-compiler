{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Compiler: full pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/compiler",
            "args": ["${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Compiler: --lex",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/compiler",
            "args": ["--lex", "${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Compiler: --parse",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/compiler",
            "args": ["--parse", "${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Compiler: --codegen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/compiler",
            "args": ["--codegen", "${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
