{
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.venv/**": true
    },
    "remote.WSL.fileWatcher.polling": true,
    "terminal.integrated.defaultProfile.windows": "AutoVenv WSL",
    "terminal.integrated.profiles.windows": {
        "AutoVenv WSL": {
            "path": "wsl.exe",
            "args": [
                "-e", "bash", "--login", "-c",
                "WORKSPACE_DIR='${workspaceFolder}' bash '${workspaceFolder}/.vscode/launch_venv.sh'"
            ]
        }
    },
    "terminal.integrated.defaultProfile.linux": "AutoVenv",
    "terminal.integrated.profiles.linux": {
        "AutoVenv": {
            "path": "bash",
            "args": ["--login", "-c", "WORKSPACE_DIR='${workspaceFolder}' bash '${workspaceFolder}/.vscode/launch_venv.sh'"]
        }
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.extraPaths": ["${workspaceFolder}/.venv/lib/python3.13/site-packages"],
    "python.terminal.activateEnvironment": false,
    "ruff.importStrategy": "useBundled",
    "isort.importStrategy": "useBundled",
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "workbench.colorCustomizations": {
        "activityBar.background": "#610606",
        "titleBar.activeBackground": "#880909",
        "titleBar.activeForeground": "#FFFBFB",
        "titleBar.inactiveBackground": "#610606",
        "titleBar.inactiveForeground": "#FFFBFB",
        "statusBar.background": "#610606",
        "statusBar.foreground": "#FFFBFB",
        "statusBar.debuggingBackground": "#610606",
        "statusBar.debuggingForeground": "#FFFBFB",
        "statusBar.noFolderBackground": "#610606",
        "statusBar.noFolderForeground": "#FFFBFB"
    }
}